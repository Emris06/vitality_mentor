# Vitality API — production env template. Paste into Railway's variables UI
# and fill in the placeholders. Anything marked `replace_me` must be set
# before the service will boot cleanly.
NODE_ENV=production
API_HOST=0.0.0.0
API_PORT=$PORT
API_LOG_LEVEL=info

# CORS origin — the deployed Vercel URL. Tighten this once a custom domain
# is wired; do not leave a wildcard in production.
WEB_ORIGIN=https://vitality.vercel.app

# Neon Postgres. The `?sslmode=require` suffix is mandatory on Neon.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/NEONDB?sslmode=require

# Upstash Redis. Use the `rediss://` (TLS) URL, not the plain `redis://` one.
REDIS_URL=rediss://default:PASSWORD@upstash-host:6379

# Sibling Railway services. Update these after Railway assigns the public URLs.
AI_SERVICE_URL=https://vitality-ai.up.railway.app
ISPRING_BASE_URL=https://vitality-ispring-mock.up.railway.app
ISPRING_API_KEY=replace_me

# Embedded background workers — keep all three on for the Ideathon demo so
# the API container is the single source of truth for the gamification +
# LMS export pipelines. Flip individually to scale out later.
GAME_WORKER_EMBEDDED=true
LMS_WORKER_EMBEDDED=true
LMS_CONSUMER_EMBEDDED=true

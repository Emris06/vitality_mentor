{
  "name": "@vitality/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:once": "tsx src/db/migrate-cli.ts",
    "db:seed:hr": "tsx src/hr/seed.ts",
    "db:seed:skills": "tsx src/skills/seed.ts",
    "db:seed:demo": "tsx src/demo/seed-demo.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.96.0",
    "@fastify/cookie": "^9.4.0",
    "@fastify/cors": "^9.0.1",
    "@fastify/sensible": "^5.6.0",
    "@vitality/shared": "workspace:*",
    "@vitality/synth-data": "workspace:*",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "jose": "^5.9.6",
    "pino-pretty": "^11.2.2",
    "postgres": "^3.4.4",
    "undici": "^6.19.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4"
  }
}

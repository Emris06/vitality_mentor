# Vitality AI — production env template.
#
# NOTE on GEN_PROVIDER: local dev uses Ollama (CPU/GPU on the developer's
# machine). Railway's free tier has no GPU, so production defaults to the
# OpenAI provider — swap to Anthropic/Groq/etc. by changing GEN_PROVIDER and
# wiring the matching key.
AI_HOST=0.0.0.0
AI_PORT=$PORT
AI_LOG_LEVEL=info

DATABASE_URL=postgresql://USER:PASSWORD@HOST/NEONDB?sslmode=require
REDIS_URL=rediss://default:PASSWORD@upstash-host:6379

EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384

GEN_PROVIDER=openai
OPENAI_API_KEY=sk-replace_me

# Unused in production (kept for parity with .env.example so the same config
# loader works in both environments).
OLLAMA_URL=
OLLAMA_MODEL=

# Brief: chat must answer within 2s. The budget below is the soft SLA the
# service self-checks against — exceeding it logs a warning, doesn't error.
CHAT_LATENCY_BUDGET_MS=2000

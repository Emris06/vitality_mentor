VITE_API_PROXY=http://localhost:4000

# Supabase (public-safe — publishable/anon key only, never paste service-role here).
# Leave both blank to disable Supabase auth (dev runs without sign-in).
# Keys: Supabase Studio → Project Settings → API → Publishable key (sb_publishable_… or legacy eyJ… anon).
# Auth → URL configuration: add http://localhost:5173/auth/callback
# For local dev: Auth → Providers → Email → disable "Confirm email" unless SMTP is configured.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

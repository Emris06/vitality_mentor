# Public env consumed by Vite at build time. Vercel rewrites /api/* to
# $API_URL via vercel.json — VITE_API_PROXY mirrors that target so client-side
# code (which can't read Vercel project env at runtime) has the absolute base
# when it needs a direct call (SSE streams, file uploads).
VITE_API_PROXY=https://vitality-api.up.railway.app
